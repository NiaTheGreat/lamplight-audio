# Required
OPENAI_API_KEY=
# Password for the login page. Required in production so strangers can't spend your OpenAI credits.
APP_PASSWORD=

# Optional
# gpt-4o-mini-tts (default, ~$0.015/min, supports tone instructions) or tts-1 ($15 per 1M characters)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ballad
TTS_INSTRUCTIONS=

# Cloudflare R2 storage (required on Vercel; leave empty locally, audio is cached in ./.cache instead).
# Create a bucket, then an API token with Object Read & Write for it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Appended to each narrated piece so the model doesn't clip the final words. Empty disables it.
# TTS_END_PAD=

# Stop narrating once this many characters have been sent to OpenAI in a calendar month (about $16 per million).
# MONTHLY_CHAR_LIMIT=3000000
