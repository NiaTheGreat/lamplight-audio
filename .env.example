# Required
OPENAI_API_KEY=
# Password for the login page. Required in production so strangers can't spend your OpenAI credits.
APP_PASSWORD=

# Optional
# Kokoro-82M narration via DeepInfra (about $1 per million characters). Leave empty and the Kokoro voices show as "needs a key".
DEEPINFRA_API_KEY=
# ElevenLabs narrators (Flash v2.5, v4 Turbo and v4 are picked as narrators in the app).
# Optional ELEVENLABS_TTS_MODEL overrides the model for Flash narrators only.
ELEVENLABS_API_KEY=
# gpt-4o-mini-tts (default, ~$0.015/min, supports tone instructions) or tts-1 ($15 per 1M characters)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ballad
TTS_INSTRUCTIONS=

# Cloudflare R2 storage (required on Vercel; leave empty locally, audio is cached in ./.cache instead).
# Create a bucket, then an API token with Object Read & Write for it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Appended to each narrated piece so the model doesn't clip the final words. Empty disables it.
# TTS_END_PAD=

# Stop narrating once this much (estimated) has been spent in a calendar month, across all narrators. Default 30.
# MONTHLY_BUDGET_USD=30
# Optional second cap in characters (all narrators). Not set by default.
# MONTHLY_CHAR_LIMIT=3000000

# Self-hosting (Docker or `lamplight-audio`); not needed on Vercel.
# Where books and audio live when R2 is not set. The Docker image uses /data.
# CACHE_DIR=
# "false" lets the login cookie work over plain http (a home network address). Default: secure in production.
# COOKIE_SECURE=false
# Where the background worker calls itself. Set it when a reverse proxy makes the public address unreachable from inside.
# WORKER_ORIGIN=http://127.0.0.1:3000
