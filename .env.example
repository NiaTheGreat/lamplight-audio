# Required
OPENAI_API_KEY=
# Password for the login page. Required in production so strangers can't spend your OpenAI credits.
APP_PASSWORD=

# Optional
# gpt-4o-mini-tts (default, ~$0.015/min, supports tone instructions) or tts-1 ($15 per 1M characters)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
TTS_INSTRUCTIONS=

# Set automatically when you add a Blob store to your Vercel project.
# Leave empty locally; audio is cached in ./.cache instead.
BLOB_READ_WRITE_TOKEN=
# Appended to each narrated piece so the model doesn't clip the final words. Empty disables it.
# TTS_END_PAD=
